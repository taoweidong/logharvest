{
  "name": "logharvest-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LogHarvest 前端（派生自 vue-pure-admin, MIT）",
  "author": {
    "name": "Taowd",
    "email": "taowd@outlook.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "rimraf dist && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "rimraf dist && vite build --mode staging",
    "report": "rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "clean:cache": "rimraf node_modules && pnpm store prune && pnpm install",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "logharvest",
    "vue3",
    "typescript",
    "element-plus",
    "vite",
    "pinia"
  ],
  "dependencies": {
    "@pureadmin/descriptions": "^1.2.1",
    "@pureadmin/table": "^3.3.0",
    "@pureadmin/utils": "^2.6.4",
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "animate.css": "^4.1.1",
    "axios": "1.18.1",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.7",
    "js-cookie": "^3.0.8",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.29.5",
    "qs": "^6.16.0",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.7",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vue-tippy": "^6.8.0",
    "vue-types": "^7.0.0"
  },
  "devDependencies": {
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/json": "^2.2.541",
    "@iconify/vue": "4.2.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.37",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "boxen": "^8.0.1",
    "code-inspector-plugin": "^2.0.9",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.10",
    "gradient-string": "^3.0.0",
    "postcss": "^8.5.29",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-router-warn": "^3.0.0",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "pnpm": ">=9"
  }
}
