venv/
.env

# SQLite (local development only)
*.db
*.db-journal
*.db-wal
*.db-shm
service/*.db

# 本地运行时产物（日志与 PID，不入库）
service/*.log
service/*.pid
web/vite_out.txt
web/vite_err.txt

# 模拟数据生成物（脚本 data/generate_mock_logs.py 入库，产物不入库）
data/logs/
data/_smoke/
data/_bench/
data/*.ZIP
data/*.zip
data/manifest.json
*.part

# Tool caches
.mypy_cache/
.pytest_cache/
