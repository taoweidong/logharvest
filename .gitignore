.hypothesis/
.coverage
.coverage.*
htmlcov/
service/coverage.json

# Node / frontend
node_modules/
dist/
coverage/
# 前端启动配置必须随仓库发布（platform-config 之外的 vite 变量，不含密钥）
!web/.env
!web/.env.development
!web/.env.production
!web/.env.staging

# IDE / OS
.idea/
.vscode/
.DS_Store

# Superseded detailed design, kept locally only
docs/superpowers/specs/archive/

# Qoder 会话内的 agent 工作树与本地缓存（含各自 node_modules/.venv，不入库）
.qoder/

# WorkBuddy 会话目录（memory / automations，不入库；不要删除）
.workbuddy/

# E2E：运行期产物与生成的测试数据集不入库（make_nas.py / up.sh 随时可重建）
e2e-*.log
e2e/artifacts/
e2e/nas/
