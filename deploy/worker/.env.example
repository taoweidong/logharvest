# 复制为同目录 .env 后按需修改：deploy/worker/.env

# --- 镜像 ---
REGISTRY=
IMAGE_TAG=latest

# --- 数据库连接（跨栈经外部网络直连数据库栈的固定容器名）---
POSTGRES_USER=logharvest
POSTGRES_PASSWORD=
POSTGRES_DB=logharvest

# --- LogHarvest 认证（生产环境 Settings 强制校验，必须与 server 栈一致提供）---
LOGHARVEST_JWT_SECRET_KEY=
LOGHARVEST_ADMIN_USERNAME=admin
LOGHARVEST_ADMIN_PASSWORD=
LOGHARVEST_ENVIRONMENT=production

# --- NAS 与临时盘 ---
# NAS 日志根目录（容器内只读挂载到 /nas）
NAS_LOGS_DIR=/mnt/nas/applogs
# Worker 本地临时盘：解压工作区，归档在数据盘 /usr1
WORK_TMP_DIR=/usr1/logharvest/worker/tmp
LOGHARVEST_WORK_DIR=/local-tmp

# --- NAS 只读守卫 ---
LOGHARVEST_NAS_READ_ONLY_POLICY=enforce

# --- Worker 运行时 ---
LOGHARVEST_MATCHES_BATCH_SIZE=1000
# 单任务命中上限：达限停止扫描，任务落 failed（不自动重试）并删除本次命中。
LOGHARVEST_MAX_MATCHES_PER_TASK=200000
LOGHARVEST_WORKER_POLL_SECONDS=1.0
