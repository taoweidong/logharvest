# 复制为同目录 .env 后按需修改：deploy/server/.env

# --- 镜像 ---
# REGISTRY 为空时使用本地构建（local/ 前缀）；Jenkins 推送后形如 registry.example.com/logharvest
REGISTRY=
IMAGE_TAG=latest

# --- 数据库连接（跨栈经外部网络直连数据库栈的固定容器名）---
POSTGRES_USER=logharvest
POSTGRES_PASSWORD=
POSTGRES_DB=logharvest

# --- LogHarvest 认证（生产必填）---
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGHARVEST_JWT_SECRET_KEY=
LOGHARVEST_ADMIN_USERNAME=admin
LOGHARVEST_ADMIN_PASSWORD=
LOGHARVEST_ENVIRONMENT=production

# --- NAS 只读守卫 ---
LOGHARVEST_NAS_READ_ONLY_POLICY=enforce

# --- 登录限流 ---
LOGHARVEST_LOGIN_MAX_ATTEMPTS=10
LOGHARVEST_LOGIN_WINDOW_SECONDS=300

# --- 端口 ---
SERVER_PORT=8000
WEB_PORT=80
