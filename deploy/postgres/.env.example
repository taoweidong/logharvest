# 复制为同目录 .env 后按需修改：deploy/postgres/.env
# 数据与备份目录默认规划在数据盘 /usr1（由 deploy/init-dirs.sh 创建并授权）。

# --- PostgreSQL 凭据（必填）---
POSTGRES_USER=logharvest
POSTGRES_PASSWORD=
POSTGRES_DB=logharvest

# --- 数据盘目录规划（全部归档在 /usr1）---
PG_DATA_DIR=/usr1/logharvest/postgres/data
PG_BACKUP_DIR=/usr1/logharvest/postgres/backup

# --- 端口（仅绑定 127.0.0.1，供宿主机运维；外部一律走内网容器名）---
POSTGRES_HOST_PORT=5432

# --- 定时备份（--profile backup 时生效；备份镜像由 postgres:18.6 本地构建）---
# SCHEDULE 支持 @daily（每天 00:00 UTC）/ @hourly / 每日 "HH:MM"（UTC）
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
