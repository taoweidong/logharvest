# LogHarvest 本地开发配置示例：复制为 service/.env 后按需修改
# 生产部署（LOGHARVEST_ENVIRONMENT 不是 dev/test）下标注了「生产必填」的变量必须显式给出，
# 否则应用在配置校验阶段就报错启动失败。
LOGHARVEST_ENVIRONMENT=dev

# --- 认证（M2a 起为 JWT 登录）---
# HS256 签名密钥，最短 32 字符，任何环境都必填（含 dev）：留空会在配置校验阶段
# 直接报错启动失败，代码里不再有内置的开发回退密钥。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGHARVEST_JWT_SECRET_KEY=
# access token 有效期（分钟）与 refresh token 有效期（天）
LOGHARVEST_ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGHARVEST_REFRESH_TOKEN_EXPIRE_DAYS=7
# scripts/seed_admin 使用的管理员账号名与口令来源。
# LOGHARVEST_ADMIN_PASSWORD 生产必填；种子脚本另有一道最短 8 位的检查。
# 注意：登录接口只校验库里的用户，不自动建号 —— 新库必须先跑
#   uv run --python 3.12 -m scripts.seed_admin
LOGHARVEST_ADMIN_USERNAME=admin
LOGHARVEST_ADMIN_PASSWORD=

# --- 数据库与迁移 ---
LOGHARVEST_DATABASE_URL=sqlite:///./logharvest.db
# Worker 与队列使用 PostgreSQL 原生语法（SKIP LOCKED、make_interval、ON CONFLICT），
# 启动 Worker 前需改为 PostgreSQL 连接串，例如：
# LOGHARVEST_DATABASE_URL=postgresql://logharvest:logharvest@127.0.0.1:5432/logharvest
# true = 应用启动（lifespan）时执行 alembic upgrade head；测试夹具会把它关掉并改用
# create_all 建内存库，因此跑测试不会碰这里的连接串
LOGHARVEST_AUTO_CREATE_TABLES=true

# --- Worker 运行时（python -m src.worker）---
# Worker 标识，默认取主机名；同一主机启动多个 Worker 进程时必须逐个设置为唯一值，
# 否则会共用 workers 表中的同一行
LOGHARVEST_WORKER_ID=worker-1
LOGHARVEST_WORKER_VERSION=0.1.0
# 本地临时盘根目录，默认系统临时目录；压缩包复制到 <work_dir>/logharvest/<worker_id>/<task_id>/
LOGHARVEST_WORK_DIR=/tmp
# 队列为空时的轮询间隔（秒）
LOGHARVEST_WORKER_POLL_SECONDS=1.0
# 命中结果批量写入条数，已接线到 Worker 处理器
LOGHARVEST_MATCHES_BATCH_SIZE=1000
# 单任务命中上限：达到上限后停止扫描，任务落 failed（不自动重试），
# 并删除本次尝试已写入的 matches，避免半截结果可见。默认 20 万。
LOGHARVEST_MAX_MATCHES_PER_TASK=200000
# 单机并发预算，M1b 由启动的 Worker 进程数实现
# （一个进程一次只处理一个任务；内存压力时按 4→3→2 减少进程数）
LOGHARVEST_MAX_CONCURRENT_COPIES=4

# --- NAS 只读守卫（规格 §7.2）---
# enforce = 判定为可写就拒绝处理；warn = 只告警；ignore = 完全沉默。
# 注意：非 POSIX 平台（Windows / SMB）读不到挂载表，判定恒为 unknown，此时 enforce
# 也不会拦截。这条保护只在 Linux + 只读挂载的环境里真正生效。
LOGHARVEST_NAS_READ_ONLY_POLICY=enforce

# --- 解压预算（规格 §11 压缩炸弹）---
# 单成员解压上限 / 整包累计上限 / 成员个数上限 / 膨胀比上限。
# 单成员超限只丢弃该成员（任务落 partial）；整包级超限停止扫描（failed 且不重试）。
LOGHARVEST_ARCHIVE_MAX_MEMBER_BYTES=1073741824
LOGHARVEST_ARCHIVE_MAX_TOTAL_BYTES=4294967296
LOGHARVEST_ARCHIVE_MAX_MEMBERS=10000
LOGHARVEST_ARCHIVE_MAX_RATIO=500.0

# --- 登录限流 ---
# 同一"用户名 + 来源 IP"在一个窗口内允许的失败登录次数；超过返回 429 与 Retry-After。
# 成功登录会清空该来源的计数。计数在进程内存中：多副本部署时实际放行量是阈值 × 副本数。
LOGHARVEST_LOGIN_MAX_ATTEMPTS=10
LOGHARVEST_LOGIN_WINDOW_SECONDS=300
# 可信反向代理的地址/CIDR，逗号分隔。仅当 TCP 对端落在此列表内时，才解析
# X-Forwarded-For / X-Real-IP；默认空 = 不信任任何转发头（直连伪造头无效）。
# 经 nginx 部署时必须把 nginx 的容器地址或所在网段填进来，否则所有登录仍按代理 IP 分桶。
LOGHARVEST_TRUSTED_PROXY_CIDRS=
